autoload -Uz log_error log_status log_info log_group mkcd

if (( ! ${+project_root} )) {
  log_error "'project_root' not set. Please set before running ${0}."
  return 2
}

if (( ! ${+target} )) {
  log_error "'target' not set. Please set before running ${0}."
  return 2
}

pushd ${project_root}

typeset -g QT_VERSION

local -a apt_args=(
  ${CI:+-y}
  --no-install-recommends
)
if (( _loglevel == 0 )) apt_args+=(--quiet)

if (( ! (${skips[(Ie)all]} + ${skips[(Ie)deps]}) )) {
  log_group 'Installing obs-studio build dependencies...'

  local suffix
  if [[ ${CPUTYPE} != "${target##*-}" ]] {
    local -A arch_mappings=(
      aarch64 arm64
      x86_64 amd64
    )

    suffix=":${arch_mappings[${target##*-}]}"

    sudo apt-get install ${apt_args} gcc-${${target##*-}//_/-}-linux-gnu g++-${${target##*-}//_/-}-linux-gnu
  }

  local apt_updated=0

  for attempt in {1..3}; do
    if sudo apt-get update; then
      apt_updated=1
      break
    fi
    sleep $(( attempt * 10 ))
  done

  if (( ! apt_updated )) {
    log_error "apt-get update failed after retries."
    return 2
  }

  # OBS 33 is only packaged in the OBS PPA; Ubuntu's own archive ships older versions.
  # The PPA's obs-studio package includes the libobs headers and CMake configs, and it
  # conflicts with Ubuntu's libobs0, so Ubuntu's libobs-dev must not be installed with it.
  local -r -i obs_minimum_major=33

  _obs_major_version() {
    if [[ ${1} =~ '^([0-9]+)\.' ]] {
      print -- ${match[1]}
    } else {
      print -- 0
    }
  }

  local obs_candidate_version="$(apt-cache policy obs-studio 2>/dev/null | sed -nE 's/^[[:space:]]*Candidate:[[:space:]]*(.*)$/\1/p')"

  if (( $(_obs_major_version "${obs_candidate_version}") < obs_minimum_major )) {
    if (( ! ${+commands[add-apt-repository]} )) {
      sudo apt-get install ${apt_args} software-properties-common
      rehash
    }

    local ppa_added=0
    for attempt in {1..3}; do
      if sudo add-apt-repository --yes ppa:obsproject/obs-studio; then
        ppa_added=1
        break
      fi
      sleep $(( attempt * 15 ))
    done

    if (( ! ppa_added )) {
      log_error "Could not add obsproject PPA after retries."
      return 2
    }

    apt_updated=0
    for attempt in {1..3}; do
      if sudo apt-get update; then
        apt_updated=1
        break
      fi
      sleep $(( attempt * 10 ))
    done

    if (( ! apt_updated )) {
      log_error "apt-get update failed after adding obsproject PPA."
      return 2
    }
  }

  sudo apt-get install ${apt_args} \
    build-essential \
    libgles2-mesa-dev \
    libsimde-dev \
    obs-studio

  local obs_installed_version="$(dpkg-query -W -f='${Version}' obs-studio)"
  if (( $(_obs_major_version "${obs_installed_version}") < obs_minimum_major )) {
    log_error "obs-studio ${obs_installed_version} is too old, OBS Studio ${obs_minimum_major} or newer is required."
    return 2
  }
  log_info "Building against obs-studio ${obs_installed_version}"

  local -a _qt_packages=()

  if (( QT_VERSION == 5 )) {
    _qt_packages+=(
      qtbase5-dev${suffix}
      libqt5svg5-dev${suffix}
      qtbase5-private-dev${suffix}
      libqt5x11extras5-dev${suffix}
    )
  } else {
    _qt_packages+=(
      qt6-base-dev${suffix}
      libqt6svg6-dev${suffix}
      qt6-base-private-dev${suffix}
    )
  }

  sudo apt-get install ${apt_args} ${_qt_packages}
  log_group
}
